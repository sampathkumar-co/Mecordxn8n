{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }

  handle / {
    redir /console 302
  }

  handle /livez {
    reverse_proxy control-api:8080
  }

  handle /console {
    reverse_proxy control-api:8080
  }

  handle /console/* {
    reverse_proxy control-api:8080
  }

  handle /v1/platform/* {
    reverse_proxy control-api:8080
  }

  handle /v1/integrations/webhooks/* {
    reverse_proxy control-api:8080
  }

  handle {
    respond 404
  }
}
