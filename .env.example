# Control API
PORT=8080
ORCHESTRATOR_TOKEN=replace-with-a-long-random-secret
WORKER_TOKEN=replace-with-a-different-long-random-secret
DATABASE_URL=postgres://mecordxn8n:replace-me@postgres:5432/mecordxn8n
DB_POOL_MAX=10

# PostgreSQL
POSTGRES_DB=mecordxn8n
POSTGRES_USER=mecordxn8n
POSTGRES_PASSWORD=replace-me

# Worker dispatch
WORKER_TRIGGER_TOKEN=replace-with-another-long-random-secret
MECORDXN8N_HTTP_OBSERVER_URL=http://http-observer:8090
MECORDXN8N_WORKER_TRIGGER_TOKEN=replace-with-the-same-worker-trigger-token

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678

# Imported n8n workflows use these variables.
MECORDXN8N_CONTROL_API_URL=http://control-api:8080
MECORDXN8N_ORCHESTRATOR_TOKEN=replace-with-the-same-orchestrator-token
