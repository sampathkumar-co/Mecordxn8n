FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /app

# Keep the Playwright base aligned with current Ubuntu security fixes while
# retaining the browser/runtime version match required by Playwright.
RUN apt-get update \
    && apt-get install -y --only-upgrade libssl3t64 openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --omit=dev \
    && rm -rf /usr/local/lib/node_modules/npm \
              /usr/local/lib/node_modules/corepack \
              /usr/lib/node_modules/npm \
              /usr/lib/node_modules/corepack \
              /usr/lib/node_modules/yarn \
              /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/npm \
              /usr/local/bin/npx \
              /usr/local/bin/corepack \
              /usr/local/bin/yarn \
              /usr/local/bin/yarnpkg \
              /usr/bin/npm \
              /usr/bin/npx \
              /usr/bin/corepack \
              /usr/bin/yarn \
              /usr/bin/yarnpkg

COPY src ./src

RUN mkdir -p /artifacts && chown -R pwuser:pwuser /app /artifacts

USER pwuser

ENV NODE_ENV=production
ENV ARTIFACT_DIR=/artifacts

EXPOSE 8091

CMD ["node", "src/workers/browser-qa-service.js"]
