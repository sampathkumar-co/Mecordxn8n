FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY src ./src

RUN mkdir -p /artifacts && chown -R pwuser:pwuser /app /artifacts

USER pwuser

ENV NODE_ENV=production
ENV ARTIFACT_DIR=/artifacts

EXPOSE 8091

CMD ["node", "src/workers/browser-qa-service.js"]
