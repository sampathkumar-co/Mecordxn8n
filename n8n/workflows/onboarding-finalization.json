{
  "name": "Mecordxn8n - Onboarding Finalization",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "onboarding-trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MECORDXN8N_CONTROL_API_URL + '/v1/maintenance/onboarding' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.MECORDXN8N_ORCHESTRATOR_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ limit: 25 }) }}",
        "options": {}
      },
      "id": "onboarding-finalize",
      "name": "Finalize First Reports",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Finalize First Reports",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
