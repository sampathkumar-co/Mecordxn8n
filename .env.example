# Immutable production image references. Replace each example with the
# exact digest validated for the release being deployed.
NODE_BASE_IMAGE=node:22-alpine@sha256:<validated-node-digest>
PLAYWRIGHT_BASE_IMAGE=mcr.microsoft.com/playwright:v1.63.0-noble@sha256:<validated-playwright-digest>
POSTGRES_IMAGE=postgres:17-alpine@sha256:<validated-postgres-digest>
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.40.7@sha256:<validated-n8n-digest>
CADDY_IMAGE=caddy:2.10-alpine@sha256:<validated-caddy-digest>

# Production ingress. external = existing host reverse proxy; standalone =
# bundled Caddy profile. Both application and n8n host ports stay loopback-only.
INGRESS_MODE=external
CONTROL_API_HOST_PORT=18080
N8N_HOST_PORT=15678
# Optional when the existing reverse proxy runs in Docker. When both are set,
# only control-api joins this pre-existing shared ingress network.
EXTERNAL_INGRESS_NETWORK=
EXTERNAL_INGRESS_UPSTREAM=

# Control API
PORT=8080
ORCHESTRATOR_TOKEN=replace-with-a-long-random-secret
BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-secret
DATABASE_URL=postgres://mecordxn8n:replace-me@postgres:5432/mecordxn8n
DB_POOL_MAX=10

# Application PostgreSQL
POSTGRES_DB=mecordxn8n
POSTGRES_USER=mecordxn8n
POSTGRES_PASSWORD=replace-me

# Dedicated n8n PostgreSQL (never reuse the application DB credentials)
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=replace-with-a-different-strong-password
N8N_DATABASE_URL=postgres://n8n:replace-with-a-different-strong-password@n8n-postgres:5432/n8n

# Worker identities - each token must be unique and at least 32 random characters
WORKER_TOKEN_HTTP_OBSERVER=replace-with-http-observer-worker-secret
WORKER_TOKEN_BROWSER_QA=replace-with-browser-qa-worker-secret
WORKER_TOKEN_SITE_DISCOVERY=replace-with-site-discovery-worker-secret
WORKER_TOKEN_JOURNEY_QA=replace-with-journey-qa-worker-secret
WORKER_TOKEN_FINDING_VERIFICATION=replace-with-verification-worker-secret
WORKER_TOKEN_REMEDIATION=replace-with-remediation-worker-secret
WORKER_TOKEN_INTEGRATION=replace-with-integration-worker-secret

# n8n -> worker trigger authentication
WORKER_TRIGGER_TOKEN=replace-with-another-long-random-secret
MECORDXN8N_WORKER_TRIGGER_TOKEN=replace-with-the-same-worker-trigger-token
MECORDXN8N_HTTP_OBSERVER_URL=http://http-observer:8090
MECORDXN8N_BROWSER_QA_URL=http://browser-qa:8091
MECORDXN8N_SITE_DISCOVERY_URL=http://site-discovery:8092
MECORDXN8N_JOURNEY_QA_URL=http://journey-qa:8093
MECORDXN8N_VERIFICATION_URL=http://finding-verification:8094
MECORDXN8N_REMEDIATION_URL=http://remediation:8095
MECORDXN8N_INTEGRATION_URL=http://integration-delivery:8096
ARTIFACT_DIR=/artifacts

# Mecord MCP remediation bridge. Prefer the dedicated OAuth
# client-credentials identity in production; MECORD_MCP_TOKEN remains supported
# for controlled environments and backward compatibility.
MECORD_MCP_URL=
MECORD_MCP_TOKEN=
MECORD_OAUTH_TOKEN_URL=
MECORD_OAUTH_CLIENT_ID=
MECORD_OAUTH_CLIENT_SECRET=
MECORD_OAUTH_AUDIENCE=
MECORD_OAUTH_SCOPE=operator:read operator:write
MECORD_MCP_REMEDIATION_TOOL=operations
MECORD_HEALTH_URL=https://mecord.example.com/healthz

# Internal dependency health
DEPENDENCY_HEALTH_ENABLED=true
N8N_HEALTH_URL=http://n8n:5678/healthz

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678

# Imported n8n workflows
MECORDXN8N_CONTROL_API_URL=http://control-api:8080
MECORDXN8N_ORCHESTRATOR_TOKEN=replace-with-the-same-orchestrator-token

# Backup encryption (required in production)
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-backup-encryption-secret

# Platform security
# Version 1 remains readable through PLATFORM_MASTER_KEY. For rotation, add
# PLATFORM_MASTER_KEY_V2, set ACTIVE_VERSION=2, run npm run rotate:integration-keys,
# then retain old keys until all rows have migrated.
PLATFORM_MASTER_KEY=replace-with-at-least-32-random-characters
PLATFORM_MASTER_KEY_ACTIVE_VERSION=1
PLATFORM_AUTH_KEY=replace-with-a-separate-authenticator-encryption-secret
REQUIRE_PRIVILEGED_MFA=true
REQUIRE_VERIFIED_EMAIL=true
MFA_STEP_UP_MINUTES=30

# Transactional authentication mail webhook. The receiver must verify
# X-Mecord-Signature (HMAC-SHA256 over the raw JSON body).
AUTH_MAIL_WEBHOOK_URL=https://mailer.example.com/mecord-auth
AUTH_MAIL_WEBHOOK_SECRET=replace-with-a-separate-auth-mail-webhook-secret

# Public production endpoints
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
PUBLIC_APP_URL=https://app.example.com

# Stripe billing (optional until billing is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
